import java.util.*;
class Main
{
 	public static void main (String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		boolean[] arr=new boolean[n];
	    int k=0;
		for(int i=2;i*i<n;i++){
		    if(arr[i]==false){
		    for(int j=i*i;j<n;j=j+i){
		        arr[j]=true;
		    }
		}}
		for(int i=2;i<n;i++){
		    if(arr[i]==false){
		        k++;
		    }
		}
		System.out.print(k);
	}
}
