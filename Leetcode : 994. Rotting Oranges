import java.util.*;
class Main
{
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int R=sc.nextInt();
        int C=sc.nextInt();
        int[][] grid=new int[R][C];
        Queue<int[]> q=new LinkedList<>();
        for(int i=0;i<R;i++){
            for(int j=0;j<C;j++){
                grid[i][j]=sc.nextInt();
                if(grid[i][j]==2){
                    q.add(new int[]{i,j,0});
                }
            }
        }
        int[] diff={0,-1,0,1,0};
        int ans=0;
        while(!q.isEmpty()){
            int[] cell=q.poll();
            int row=cell[0],col=cell[1],cmin=cell[2];
            ans=cmin;
            for(int i=0;i<4;i++){
                int ar=row+diff[i],ac=col+diff[i+1];
                if(ar>=0 && ar<R && ac>=0 && ac<C){
                    if(grid[ar][ac]==1){
                        grid[ar][ac]=2;
                        q.add(new int[]{ar,ac,cmin+1});
                    }
                }
            }
        }
        for(int i=0;i<R;i++){
            for(int j=0;j<C;j++){
                if(grid[i][j]==1){
                    System.out.println(-1);
                    return;
                }
            }
        }
        System.out.println(ans);
    }
}
