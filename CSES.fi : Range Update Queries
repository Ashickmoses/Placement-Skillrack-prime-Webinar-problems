
#include<bits/stdc++.h>
using namespace std;
void find(vector<long long>& seg,int node,int nl,int nr,int ql,int qr,long long val){
    if(nl>qr || nr<ql){
        return ;
    }
    if(nl>=ql && nr<=qr ){
         seg[node]=seg[node]+val;
         return;
    }
    int mid=(nl+nr)/2;
    find(seg,2*node,nl,mid,ql,qr,val);
    find(seg,2*node+1,mid+1,nr,ql,qr,val);
}
long long query(vector<long long>& seg,int node,int nl,int nr,int k,long long sum){
    sum+=seg[node];
    if(nl==nr){
        return sum;
    }
    int mid=(nl+nr)/2;
    if(k<=mid){
        return query(seg,2*node,nl,mid,k,sum);
    }
    else{
        return query(seg,2*node+1,mid+1,nr,k,sum);
    }
}
int main(){
    int n,q;
    cin>>n>>q;
    int newn=1;
    while(newn<n){
        newn=newn*2;
    }
    vector<long long> seg(newn*2,0);
    for(int i=newn;i<newn+n;i++){
        cin>>seg[i];
    }
    n=newn;
    while(q--){
        int qt;
        cin>>qt;
        if(qt==1){
        int ql,qr;
        long long val;
        cin>>ql>>qr>>val;
        find(seg,1,1,n,ql,qr,val);
    }
        else{
            int k;
            cin>>k;
            cout<<query(seg,1,1,n,k,0)<<endl;
        }
    }
}
