#include<bits/stdc++.h>
using namespace std;
int find(vector<int>& seg,int node,int nl,int nr,int ql,int qr){
    if(qr<nl || ql>nr){
        return INT_MAX;
    }
    if(nl>=ql && nr<=qr){
        return seg[node];
    }
    int mid=(nl+nr)/2;
    int lc=find(seg,2*node,nl,mid,ql,qr);
    int rc=find(seg,2*node+1,mid+1,nr,ql,qr);
    return min(lc,rc);
}
int main(){
    int n,q;
    cin>>n>>q;
    int newn=1;
    while(newn<n){
        newn=newn*2;
    }
    vector<int> seg(2*newn,INT_MAX);
    for(int i=newn;i<newn+n;i++){
        cin>>seg[i];
    }
    for(int i=newn-1;i>=1;i--){
        seg[i]=min(seg[i+i],seg[i+i+1]);
    }
    n=newn;
    while(q--){
        int ql,qr;
        cin>>ql>>qr;
        cout<<find(seg,1,1,n,ql,qr)<<"\n";
    }
    return 0;
}
